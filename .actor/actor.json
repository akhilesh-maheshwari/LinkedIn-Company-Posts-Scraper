{
  "actorSpecification": 1,
  "name": "linkedin-company-posts-scraper-no-cookies",
  "title": "LinkedIn Company Posts Scraper (No Cookies)",
  "description": "Scrape LinkedIn company posts including post content, likes, comments, shares, and more. No LinkedIn cookies required.",
  "version": "1.0",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn Company Posts Output",
    "description": "Scraped LinkedIn company post data including post content, reactions, comments, reposts, and media.",
    "properties": {
      "results": {
        "type": "string",
        "title": "LinkedIn Company Posts",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "input_company",
              "company_name",
              "company_linkedin_url",
              "company_id",
              "company_followers",
              "fetch_status",
              "post_id",
              "post_url",
              "posted_at",
              "post_text",
              "reaction_count",
              "comment_count",
              "repost_count",
              "impressions_count",
              "is_repost",
              "media_types",
              "media_urls"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
